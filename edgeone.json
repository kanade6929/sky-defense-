{
  "installCommand": "node -v",
  "buildCommand": "node tools/publish-edgeone.cjs",
  "outputDirectory": "out/edgeone",
  "nodeVersion": "22.11.0",
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/build.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/*.wasm", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/*.worklet.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/index.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
